#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# finish-bootloader efi|bios TARGET [BOOT-DISK]
#
# Called by the Zovelis OS installer after GRUB was installed into the new
# system mounted at TARGET.
#   * UEFI: also install the boot loader (with Secure Boot shim) in the
#     fallback location EFI/BOOT, which firmware uses when its boot entries
#     are lost (common in virtual machines and on some laptops), and give it
#     the configuration it needs there (see below).
#   * Both: check that a GRUB menu was generated.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
export DEBIAN_FRONTEND=noninteractive
export LC_ALL=C.UTF-8

log() { echo "finish-bootloader: $*" >&2; }
die() { log "ERROR: $*"; exit 1; }

[ "$#" -ge 2 ] || die "usage: finish-bootloader efi|bios TARGET [BOOT-DISK]"
firmware=$1
target=$2
disk=${3:-}
case "$target" in
    /*) ;;
    *) die "the target must be an absolute path (got '$target')" ;;
esac
[ "$target" != / ] || die "refusing to work on the running system"
mountpoint -q "$target" || die "$target is not a mount point"

case "$firmware" in
    efi)
        esp=$target/boot/efi
        mountpoint -q "$esp" || die "the EFI system partition is not mounted at $esp"
        # The EFI system partition is FAT: names are not case-sensitive, and
        # other systems may have created EFI/boot or efi/BOOT.
        esp_find() {
            find "$esp" -maxdepth 3 -ipath "$esp/$1" -type "$2" 2>/dev/null | head -n 1
        }
        chroot "$target" grub-install --target=x86_64-efi --efi-directory=/boot/efi \
            --bootloader-id=zovelis --force-extra-removable --no-nvram --recheck
        for f in EFI/zovelis/grubx64.efi EFI/BOOT/BOOTX64.EFI; do
            [ -n "$(esp_find "$f" f)" ] || die "$f was not installed"
        done
        # With Secure Boot support, grub-install uses Debian's signed GRUB.
        # Its search path is built in: grub.cfg next to itself first (for
        # EFI/zovelis, grub-install writes that file), then EFI/debian. The
        # copy in EFI/BOOT therefore needs the same grub.cfg next to it;
        # without it, starting through the fallback path ends at a "grub>"
        # prompt, or in another system's EFI/debian menu.
        vendor_cfg=$(esp_find EFI/zovelis/grub.cfg f)
        boot_dir=$(esp_find EFI/BOOT d)
        if [ -n "$vendor_cfg" ]; then
            cp "$vendor_cfg" "$boot_dir/grub.cfg.new"
            mv -f "$boot_dir/grub.cfg.new" "$boot_dir/grub.cfg"
            log "the fallback boot path uses the configuration of EFI/zovelis"
        elif [ -e "$boot_dir/grub.cfg" ]; then
            # GRUB was built for this computer (no Secure Boot packages) and
            # needs no file there, but would read one left by another system.
            rm -f "$boot_dir/grub.cfg"
            log "removed an old grub.cfg from the fallback boot path"
        fi
        ;;
    bios)
        if [ -z "$disk" ]; then
            log "no boot loader location chosen; nothing to check"
            exit 0
        fi
        ;;
    *)
        die "unknown firmware type '$firmware'"
        ;;
esac

[ -s "$target/boot/grub/grub.cfg" ] || die "no GRUB menu was generated"
grep -q '^menuentry ' "$target/boot/grub/grub.cfg" || die "the GRUB menu has no entries"
log "done"
