#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# zovelis-install — start the Zovelis OS installer from the live system.
#
# The installer (Calamares) needs administrator rights to partition disks; it
# is started through pkexec. On the live system no password is asked (see
# /usr/share/polkit-1/rules.d/49-zovelis-installer.rules).
set -eu

title="Install Zovelis OS"

say() {
    echo "zovelis-install: $1" >&2
    if command -v kdialog >/dev/null 2>&1 && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
        kdialog --title "$title" --sorry "$1" >/dev/null 2>&1 || true
    fi
}

if [ ! -d /run/live/medium ]; then
    say "The installer can only be started from the Zovelis OS live system (a USB stick or DVD)."
    exit 1
fi

if pgrep -x calamares >/dev/null 2>&1; then
    say "The installer is already running."
    exit 0
fi

if [ -z "${DISPLAY:-}" ]; then
    say "The installer needs a graphical session."
    exit 1
fi

exec pkexec /usr/libexec/zovelis-installer/run-calamares
