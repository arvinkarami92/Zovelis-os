{
  "name": "zemvii",
  "version": "0.1.0",
  "private": true,
  "description": "Zemvii: the social network that works for you. Your people. Your feed. Your rules.",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w web",
    "build:demo": "npm run build:demo -w web",
    "start": "npm start -w server",
    "test": "npm test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "e2e": "node scripts/e2e.mjs",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "playwright-core": "^1.56.1"
  }
}
