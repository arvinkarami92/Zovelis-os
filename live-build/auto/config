#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# live-build configuration of the Zovelis OS live/installation image.
# Run through scripts/build-iso.sh, which prepares config/ first.
set -e

MIRROR=${ZOVELIS_MIRROR:-https://deb.debian.org/debian/}
SECURITY_MIRROR=${ZOVELIS_SECURITY_MIRROR:-https://security.debian.org/debian-security/}
VERSION=${ZOVELIS_VERSION:-1.0}

lb config noauto \
    --mode debian \
    --distribution trixie \
    --architecture amd64 \
    --archive-areas "main contrib non-free-firmware" \
    --mirror-bootstrap "$MIRROR" \
    --mirror-chroot "$MIRROR" \
    --mirror-chroot-security "$SECURITY_MIRROR" \
    --mirror-binary "https://deb.debian.org/debian/" \
    --mirror-binary-security "https://security.debian.org/debian-security/" \
    --security true \
    --updates true \
    --backports false \
    --apt-recommends true \
    --apt-indices true \
    --firmware-binary false \
    --firmware-chroot false \
    --linux-flavours amd64 \
    --debian-installer none \
    --bootloaders "syslinux,grub-efi" \
    --uefi-secure-boot enable \
    --memtest memtest86+ \
    --binary-image iso-hybrid \
    --chroot-squashfs-compression-type zstd \
    --iso-application "Zovelis OS $VERSION" \
    --iso-publisher "Zovelis OS Developers" \
    --iso-volume "ZOVELIS_${VERSION}" \
    --image-name "zovelis-os-${VERSION}-amd64" \
    --bootappend-live "boot=live components quiet splash username=zovelis user-fullname=Zovelis hostname=zovelis" \
    --checksums sha256 \
    --zsync false \
    --source false \
    "${@}"
