# SPDX-License-Identifier: GPL-3.0-or-later
# Zovelis OS desktop. The image installs Recommends, as Debian does by
# default; config/apt/zovelis-keep-out.pref keeps network servers, a few
# unneeded background services and Debian's own artwork out.
# Everything listed here is marked "manually installed", so removing one
# application later never removes others, and the packages each feature
# needs stay even if a recommendation changes.

# Zovelis OS packages (built from packages/ in this source tree)
zovelis-base
zovelis-artwork
zovelis-desktop-settings
zovelis-desktop
zovelis-welcome

# Plasma desktop, sessions, login screen
plasma-desktop
plasma-workspace
kwin-wayland
kwin-x11
xwayland
xserver-xorg
sddm
sddm-theme-breeze
kde-config-sddm
polkit-kde-agent-1
kscreen
kde-config-screenlocker
plasma-integration
qml6-module-org-kde-desktop
xdg-desktop-portal-kde
xdg-user-dirs
xdg-utils
kde-cli-tools
kdialog
kmenuedit

# Look: Breeze styles, icons, cursors, GTK integration, fonts
breeze
breeze-gtk-theme
breeze-icon-theme
breeze-cursor-theme
kde-config-gtk-style
fonts-noto-core
fonts-noto-ui-core
fonts-noto-mono
fonts-noto-color-emoji
fonts-liberation
fonts-hack

# Hardware: network, Bluetooth, sound, power, displays, storage
network-manager
plasma-nm
# Wi-Fi (NetworkManager only recommends these), the regulatory database for
# the allowed Wi-Fi channels, and connection sharing (hotspot)
wpasupplicant
wireless-regdb
dnsmasq-base
# Login sessions registered with systemd-logind (device access, suspend,
# polkit) and the per-user D-Bus that Plasma uses
libpam-systemd
dbus-user-session
bluez
bluedevil
pipewire-audio
wireplumber
plasma-pa
powerdevil
power-profiles-daemon
upower
udisks2
kio-extras
ffmpegthumbs
kdegraphics-thumbnailers
ntfs-3g
exfatprogs
dosfstools
btrfs-progs
xfsprogs
# Virtual machines: clipboard sharing, screen resizing, clean shutdown from
# the host. Each one only runs inside its own kind of virtual machine.
spice-vdagent
open-vm-tools-desktop
qemu-guest-agent

# Settings, information, software and updates
systemsettings
kinfocenter
plasma-discover
plasma-discover-backend-flatpak
plasma-discover-backend-fwupd
packagekit
fwupd
flatpak
xdg-desktop-portal
kde-config-flatpak
plasma-firewall
ufw
unattended-upgrades
apparmor
systemd-zram-generator
plymouth
plymouth-label

# Applications
firefox-esr
dolphin
konsole
kwrite
ark
gwenview
okular
kde-spectacle
kcalc
elisa
haruna
plasma-systemmonitor
partitionmanager

# Accessibility
orca
speech-dispatcher
espeak-ng

# Printing (driverless network and USB printers; cups-filters converts
# documents for the printers)
cups
cups-filters
cups-pk-helper
print-manager
ipp-usb
avahi-daemon
libnss-mdns

# Passwords: unlock the KDE wallet with the login password
libpam-kwallet5
kwalletmanager

# Command line basics
sudo
bash-completion
nano
less
man-db
curl
wget
ca-certificates
zip
unzip
7zip
file
pciutils
usbutils
locales
console-setup
keyboard-configuration
hunspell-en-us
