#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Stop the build if the image does not have the Zovelis OS defaults. Each
# check corresponds to a requirement of the project brief.
set -eu

failures=0
check() {
    description=$1
    shift
    if "$@" >/dev/null 2>&1; then
        echo "I: Zovelis check ok: $description"
    else
        echo "E: Zovelis check FAILED: $description"
        failures=$((failures + 1))
    fi
}
installed() {
    [ "$(dpkg-query -W -f '${db:Status-Status}' "$1" 2>/dev/null)" = installed ]
}
# (dpkg reports packages it merely knows about as "not-installed": compare
# the whole word.)
absent() {
    ! installed "$1"
}

# /etc/os-release itself is put right after live-build has finished the
# root file system (auto/finish-chroot) and checked in the finished image
# (9000-zovelis-verify-boot.hook.binary): while live-build builds, it keeps
# its own /etc/os-release in place.
check "Zovelis os-release installed (/usr/lib/os-release)" grep -qx 'ID=zovelis' /usr/lib/os-release
check "Debian's os-release is kept as a diversion" test -f /usr/lib/os-release.debian
check "firewall enabled at boot" grep -qx 'ENABLED=yes' /etc/ufw/ufw.conf
check "automatic security updates enabled" grep -q 'Unattended-Upgrade "1"' /etc/apt/apt.conf.d/20auto-upgrades
check "AppArmor installed" installed apparmor
check "Flatpak installed" installed flatpak
check "Flathub preconfigured" test -s /usr/share/flatpak/remotes.d/flathub.flatpakrepo
check "Zovelis global themes installed" test -f /usr/share/plasma/look-and-feel/org.zovelis.light.desktop/contents/defaults
check "Zovelis global theme is the default" grep -qx 'LookAndFeelPackage=org.zovelis.light.desktop' /etc/xdg/kdeglobals
check "Zovelis login screen selected" grep -qx 'Current=zovelis' /etc/sddm.conf.d/10-zovelis.conf
check "Zovelis login screen installed" test -f /usr/share/sddm/themes/zovelis/Main.qml
check "Breeze login screen present (used by the Zovelis one)" test -f /usr/share/sddm/themes/breeze/Main.qml
# Both login screens are Qt 6 themes (QtVersion=6), shown by SDDM's Qt 6 greeter.
check "login screen can show Qt 6 themes" test -x /usr/bin/sddm-greeter-qt6
check "Plasma (Wayland) session available" test -f /usr/share/wayland-sessions/plasma.desktop
check "Zovelis boot splash is the default" sh -c 'plymouth-set-default-theme | grep -qx zovelis'
check "welcome app finds all its libraries" sh -c 'ldd /usr/bin/zovelis-welcome >/dev/null && ! ldd /usr/bin/zovelis-welcome | grep -q "not found"'
# Starting it needs Qt's "offscreen" platform plugin, which the desktop
# itself does not need; run it only if some package brought the plugin in.
if [ -e /usr/lib/x86_64-linux-gnu/qt6/plugins/platforms/libqoffscreen.so ]; then
    check "welcome app starts" sh -c 'QT_QPA_PLATFORM=offscreen zovelis-welcome --version'
fi
check "installer configured" test -f /etc/calamares/branding/zovelis/branding.desc
check "live session logs in to Plasma automatically" test -x /usr/lib/live/config/0086-zovelis-sddm
check "live-config's own SDDM step runs first" test -x /usr/lib/live/config/0085-sddm
check "live session never locks itself (no password needed)" test -x /usr/lib/live/config/0087-zovelis-live-session
check "GRUB packages for the installer present" sh -c 'ls /usr/share/zovelis-installer/pool/bios/grub-pc_*.deb /usr/share/zovelis-installer/pool/efi/grub-efi-amd64_*.deb'
check "web browser installed" installed firefox-esr
check "file manager installed" installed dolphin
check "terminal installed" installed konsole
check "settings app installed" installed systemsettings
check "software center installed" installed plasma-discover
check "no SSH server" absent openssh-server
for server in exim4-daemon-light exim4-daemon-heavy postfix rpcbind cups-browsed akonadi-server kdeconnect \
    plasma-welcome popularity-contest desktop-base sddm-theme-debian-breeze; do
    check "no $server" absent "$server"
done
check "Wi-Fi support (wpasupplicant)" installed wpasupplicant
check "Wi-Fi channel rules (wireless-regdb)" installed wireless-regdb
check "login sessions registered with logind" installed libpam-systemd
check "printing filters" installed cups-filters
check "laptop speaker firmware (Cirrus Logic)" installed firmware-cirrus
check "no network-switch firmware" absent firmware-marvell-prestera
check "live user can be created (user-setup)" installed user-setup
check "no password-less sudo rules" sh -c '! grep -rEqs "^[^#]*NOPASSWD" /etc/sudoers /etc/sudoers.d'
check "machine-id is empty" sh -c '[ ! -s /etc/machine-id ]'

if [ "$failures" -ne 0 ]; then
    # Details for the build log ("D:" lines), to find the cause quickly.
    oneline() { tr '\n' ';' | cut -c1-400; }
    echo "D: os-release: $(ls -l /etc/os-release /usr/lib/os-release* 2>&1 | oneline)"
    echo "D: os-release IDs: $(grep -H '^ID=' /etc/os-release /usr/lib/os-release* 2>&1 | oneline)"
    echo "D: diversions: $(dpkg-divert --list '*os-release*' 2>&1 | oneline)"
    echo "D: zovelis-base: $(dpkg-query -W -f '${db:Status-Status} ${Version}' zovelis-base 2>&1)"
    echo "D: preferences: $(ls -l /etc/apt/preferences /etc/apt/preferences.d 2>&1 | oneline)"
    echo "D: boot splash: $(plymouth-set-default-theme 2>&1 | oneline) default.plymouth=$(readlink -f /usr/share/plymouth/themes/default.plymouth 2>&1)"
    for p in openssh-server cups-browsed kdeconnect plasma-welcome desktop-base firmware-marvell-prestera; do
        installed "$p" || continue
        echo "D: $p is installed; $(apt-cache policy "$p" 2>&1 | sed -n '2,4p' | oneline) needed by: $(apt-cache rdepends --installed --no-suggests --no-enhances "$p" 2>/dev/null | tail -n +3 | tr '\n' ' ' | cut -c1-300)"
    done
    echo "E: Zovelis: $failures check(s) failed"
    exit 1
fi
